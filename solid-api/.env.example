ENV=production
PORT=3000
SOLID_APP_NAME=LeadTrack CRM
BASE_URL=https://crm.example.com
DEFAULT_DATABASE_HOST=postgres
DEFAULT_DATABASE_PORT=5432
DEFAULT_DATABASE_USER=leadtrack
DEFAULT_DATABASE_PASSWORD=replace-me
DEFAULT_DATABASE_NAME=leadtrack
DEFAULT_DATABASE_SYNCHRONIZE=false
DEFAULT_DATABASE_LOGGING=false
DEFAULT_DATABASE_POOL_MAX=20
IAM_PASSWORD_LESS_REGISTRATION=false
IAM_ALLOW_PUBLIC_REGISTRATION=false
IAM_ACTIVATE_USER_ON_REGISTRATION=false
IAM_DEFAULT_ROLE=SalesRepresentative
IAM_JWT_TOKEN_AUDIENCE=leadtrack
IAM_JWT_TOKEN_ISSUER=leadtrack
IAM_JWT_SECRET=replace-with-a-long-random-secret
COMMON_EMAIL_PROVIDER=SMTPEMailService
COMMON_SMTP_EMAIL_SMTP_HOST=smtp.example.com
COMMON_SMTP_EMAIL_SMTP_PORT=587
COMMON_SMTP_EMAIL_USERNAME=replace-me
COMMON_SMTP_EMAIL_PASSWORD=replace-me
COMMON_SMTP_EMAIL_FROM=crm@example.com
