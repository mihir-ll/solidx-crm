            "list",
            "kanban"
          ],
          "predefinedSearches": [
            {
              "name": "Contact or Company",
              "description": "Search contact name or company",
              "filters": {
                "$or": [
                  {
                    "name": {
                      "$containsi": "{{search}}"
                    }
                  },
                  {
                    "company": {
                      "$containsi": "{{search}}"
                    }
                  }
                ]
              }
            }
